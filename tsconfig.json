{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node", "bun"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/*.js"]
}
