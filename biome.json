{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": { "ignore": ["node_modules", "dist", "build", "out"] },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "linter": {
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off" },
      "complexity": { "noForEach": "off" },
      "suspicious": { "noAssignInExpressions": "off" }
    }
  },
  "javascript": { "globals": ["Motion", "Sound", "Aurora", "Ears"] }
}
